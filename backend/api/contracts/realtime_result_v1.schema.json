{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realtime Cable Result v1",
  "description": "The single result structure returned by session initialization and every accepted update.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "sequence",
    "time_s",
    "cable",
    "cable_shape",
    "tensions",
    "vessel_departure_angles",
    "minimum_bend_radius",
    "bending",
    "manufacturer_limits",
    "runtime"
  ],
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "time_s": {"type": "number", "minimum": 0},
    "cable": {
      "type": "object",
      "description": "Session cable metadata echoed unchanged from initialization.",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}
      }
    },
    "cable_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "segment_tensions_n"],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/point"}
        },
        "segment_tensions_n": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number", "minimum": 0}
        }
      }
    },
    "tensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top_tension_n",
        "plough_inlet_tension_n",
        "measured_top_tension_n",
        "top_tension_residual_n"
      ],
      "properties": {
        "top_tension_n": {"type": "number", "minimum": 0},
        "plough_inlet_tension_n": {"type": "number", "minimum": 0},
        "measured_top_tension_n": {"type": ["number", "null"], "minimum": 0},
        "top_tension_residual_n": {"type": ["number", "null"]}
      }
    },
    "vessel_departure_angles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizontal_deg", "vertical_deg"],
      "properties": {
        "horizontal_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "vertical_deg": {"type": "number", "minimum": -90, "maximum": 90}
      }
    },
    "minimum_bend_radius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_m"],
      "properties": {
        "minimum_m": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "bending": {
      "type": "object",
      "description": "Unfiltered discrete centerline-curvature diagnostics using the session effective EI.",
      "additionalProperties": false,
      "required": [
        "effective_stiffness_n_m2",
        "maximum_curvature_per_m",
        "minimum_curvature_radius_m",
        "maximum_moment_n_m"
      ],
      "properties": {
        "effective_stiffness_n_m2": {"type": "number", "minimum": 0},
        "maximum_curvature_per_m": {"type": ["number", "null"], "minimum": 0},
        "minimum_curvature_radius_m": {"type": ["number", "null"], "minimum": 0},
        "maximum_moment_n_m": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "manufacturer_limits": {
      "type": "object",
      "description": "Echoed manufacturer references; no automatic pass/fail semantics.",
      "additionalProperties": false,
      "required": [
        "installation_lc_mbr_m",
        "normal_operation_lc_mbr_m",
        "storage_dc_mbr_m",
        "installation_dc_mbr_m",
        "maximum_working_load_n",
        "maximum_abnormal_operation_load_n",
        "dwp_breaking_load_n"
      ],
      "properties": {
        "installation_lc_mbr_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "normal_operation_lc_mbr_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "storage_dc_mbr_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "installation_dc_mbr_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "maximum_working_load_n": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "maximum_abnormal_operation_load_n": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "dwp_breaking_load_n": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compute_wall_s", "realtime_factor"],
      "properties": {
        "compute_wall_s": {"type": "number", "minimum": 0},
        "realtime_factor": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "x_m", "y_m", "z_m"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "x_m": {"type": "number"},
        "y_m": {"type": "number"},
        "z_m": {"type": "number"}
      }
    }
  }
}
